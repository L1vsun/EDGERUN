# Copy to .env.local for local dev, or set these as build-time env vars in
# your static-export CI (GitHub Actions) job. All NEXT_PUBLIC_* vars are
# baked into the static bundle at build time - there is no server at runtime
# once this is exported for GitHub Pages.

# Deployed origin. Required for social cards: og:image must be an absolute URL,
# and without this it resolves against localhost and never unfurls.
NEXT_PUBLIC_SITE_URL=https://edgerun.live
NEXT_PUBLIC_EDGERUN_TICKER=$EDGERUN

# Set at launch. This one variable switches on the price card, the chart, and
# every buy button (which point at PONS_LAUNCHPAD_BASE/<this address>).
# Left empty, the site renders its pre-launch "armed" state instead of dead
# links or an empty chart frame.
NEXT_PUBLIC_EDGERUN_CONTRACT_ADDRESS=

NEXT_PUBLIC_PONS_LAUNCHPAD_BASE=https://www.ponsfamily.com/launchpad
# Only set this to override the Pons launchpad with a different buy venue.
NEXT_PUBLIC_EDGERUN_DEX_URL=

NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/L1vsun/EDGERUN
