# Copy to .env.local for local dev, or set these as build-time env vars in
# your static-export CI (GitHub Actions) job. All NEXT_PUBLIC_* vars are
# baked into the static bundle at build time — there is no server at runtime
# once this is exported for GitHub Pages.

NEXT_PUBLIC_API_BASE=http://localhost:8811
NEXT_PUBLIC_EDGERUN_TICKER=$EDGERUN
NEXT_PUBLIC_EDGERUN_CONTRACT_ADDRESS=
NEXT_PUBLIC_EDGERUN_DEX_URL=
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/<org>/edgerun
