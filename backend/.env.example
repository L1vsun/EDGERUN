# Copy to .env (or set as real env vars in your hosting provider — Railway,
# Render, Fly.io, a VPS, etc). Loaded via plain os.environ, no dotenv magic —
# export these however your process manager expects.

EDGERUN_CONFIG=../edgerun/data/known_tokens.json
CACHE_DB_PATH=./edgerun_cache.db

SCAN_CACHE_TTL_SECONDS=300
POLL_INTERVAL_SECONDS=45
FEED_MAX_ITEMS=200
RATE_LIMIT_PER_MINUTE=12

# Comma-separated. Set to your deployed frontend origin(s) once known, e.g.
# https://yourname.github.io — "*" is fine for local dev, not for production.
CORS_ORIGINS=*

EDGERUN_TOKEN_TICKER=$EDGERUN

# Set this at launch. It switches on price sampling, the chart, and every buy
# link (which resolve to PONS_LAUNCHPAD_BASE/<this address>). Empty = the site
# renders its explicit pre-launch state everywhere.
EDGERUN_CONTRACT_ADDRESS=

PONS_LAUNCHPAD_BASE=https://www.ponsfamily.com/launchpad
# Only set this to send buy links somewhere other than the Pons launchpad.
EDGERUN_DEX_URL=

# Price/holders samples: how often one is taken, and how long they're kept.
# Blockscout serves no price history, so this table IS the chart's data.
TOKEN_SAMPLE_INTERVAL_SECONDS=60
TOKEN_HISTORY_MAX_AGE_DAYS=30
