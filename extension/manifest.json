{
  "manifest_version": 3,
  "name": "edgerun - Robinhood Chain token checks",
  "version": "0.1.0",
  "description": "Tells you whether the $TICKER in that post is the real contract. Checks run in your browser, against the chain, with no server in between.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://robinhoodchain.blockscout.com/*",
    "https://rpc.mainnet.chain.robinhood.com/*",
    "https://api.robinhood.com/*",
    "https://api.dexscreener.com/*",
    "https://l1vsun.github.io/*"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dexscreener.com/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/dexscreener.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://robinhoodchain.blockscout.com/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/blockscout.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/twitter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer",
        "enabled": true,
        "path": "rules/referer.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "edgerun",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}