{
  "manifest_version": 3,
  "name": "EDGERUN - token and caller checks",
  "version": "0.7.0",
  "description": "Which mint is in that post, who paid for its holders, and what the poster's wallet did. Solana and five EVM chains, in your browser.",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://solana-rpc.publicnode.com/*",
    "https://lite-api.jup.ag/*",
    "https://api.jup.ag/*",
    "https://datapi.jup.ag/*",
    "https://public.rpc.solanavibestation.com/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://tokens.uniswap.org/*",
    "https://edgerun.pro/*",
    "https://l1vsun.github.io/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://mainnet.base.org/*",
    "https://arb1.arbitrum.io/*",
    "https://bsc-rpc.publicnode.com/*",
    "https://rpc.mainnet.chain.robinhood.com/*",
    "https://robinhoodchain.blockscout.com/*",
    "https://api.robinhood.com/*"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/twitter.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dexscreener.com/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/dexscreener.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://solscan.io/*",
        "https://pump.fun/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/solana-pages.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://robinhoodchain.blockscout.com/*"
      ],
      "js": [
        "shared/detect.js",
        "shared/badge.js",
        "sites/blockscout.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer",
        "enabled": true,
        "path": "rules/referer.json"
      }
    ]
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "EDGERUN",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
